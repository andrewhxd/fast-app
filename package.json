{
  "name": "fast-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --mode preview",
    "dev:mobile": "vite --host --mode mobile",
    "dev:local": "firebase emulators:exec --only firestore --ui --project demo-fast-app \"node scripts/seed.js && vite --mode emulator\"",
    "seed:preview": "node scripts/seed.js --preview",
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "deploy:preview": "npm run build:preview && firebase hosting:channel:deploy group-audio-management --project fast-app-2026 --expires 30d",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "firebase": "^13.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "soundtouchjs": "^0.3.0",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.33.0",
    "vite": "^7.1.0"
  }
}
