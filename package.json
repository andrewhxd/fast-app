{
  "name": "fast-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --host --mode mobile",
    "dev:remote": "vite --mode dev",
    "dev:local": "firebase emulators:exec --only firestore,auth --ui --project demo-fast-app \"node scripts/seed.js && vite --mode emulator\"",
    "build": "vite build",
    "build:dev": "vite build --mode dev",
    "deploy:dev": "vite build --mode dev && firebase deploy --only firestore,hosting --project dev",
    "deploy:branch": "vite build --mode dev && node scripts/deploy-branch.js",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-fast-app \"node --test tests/rules.test.js\""
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "firebase": "^13.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "soundtouchjs": "^0.3.0",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.33.0",
    "vite": "^7.1.0"
  }
}
