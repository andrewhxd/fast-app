# `npm run dev:local`: the app talks to Firestore and Auth emulators on this computer instead of a real project.
# Projects whose ID starts with "demo-" exist only in the emulator, so nothing here can reach live data.
# This file takes priority over .env and .env.local, so every value is set, even the empty ones.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-fast-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-fast-app
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_EMULATOR=127.0.0.1:8080
VITE_AUTH_EMULATOR=127.0.0.1:9099
