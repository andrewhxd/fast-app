rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// The FAST app prototype, in its own Firebase project (fast-app-cs499).
// Everyone signs in with Firebase Authentication (Google, or an email address and a password).
// Stories belong to a group (a care team for one patient), and only the group's members can
// read them. Each member has an access level (slide 4), which decides what else they can do:
//   - "administrator": invite and remove people and change their access, record and edit stories, play
//   - "clinician": record and edit stories, play (the clinician's own tools aren't built yet)
//   - "stories": record and edit stories
//   - "player": play story sets
// The owner (the lead caregiver) can do everything, and members who joined before access levels
// existed count as "stories". Writes are strictly validated, and everything else is denied.
//
// Collection: groups/{groupId}
// Group ID: lowercase letters, numbers and hyphens (the app makes 20 random characters).
// Fields (all required at create, no others, never change after create):
//   - id: string - the same as the document ID
//   - name: string (1-100 chars) - the patient's name, e.g. "Sam Smith"
//   - ownerId: string - the uid of the lead caregiver, who started the group
//   - createdAt, updatedAt: timestamp - server time of the create
// Field added later, once:
//   - hearingAid: bool - whether the patient uses a hearing aid or other hearing accommodation,
//     answered by a member who can play the first time a set is played; it can't be changed after that
// Only members can read a group. It's created together with its owner's member document.
//
// Subcollection: groups/{groupId}/members/{uid}
// Document ID: the member's uid
// Fields (only access changes after create):
//   - uid: string (required) - the same as the document ID
//   - name: string (required, 1-100 chars) - the member's name
//   - email: string (required) - the member's sign-in email address, lowercase
//   - joinedAt: timestamp (required) - server time of joining
//   - access: string (optional) - the access level: "administrator" for the owner, and the
//     invite's level for everyone else; absent means "stories" (members from before access levels,
//     and older versions of the app, which don't write it)
//   - invite: string (optional) - the ID of the invite they accepted; absent for the owner
// Members of a group can read each other's member documents, and everyone can find their own
// (a collection group query on uid). A member is added only by starting a group or by accepting
// an invite. The owner and administrators can change anyone else's access (never their own or the
// owner's) and remove them; anyone but the owner can leave.
//
// Subcollection: groups/{groupId}/invites/{inviteId}
// Document ID: auto-generated; it's the secret part of the invite link
// Fields (all required, no others, never change):
//   - email: string - the lowercase email address the invite is for
//   - groupName: string - the group's name, so the invitee can see it before joining
//   - invitedBy: string - the uid of who invited them (the owner or an administrator)
//   - invitedByName: string (1-100 chars) - their name
//   - access: string (optional) - the access level the person joins with; absent means "stories"
//   - createdAt: timestamp - server time of the create
// Only the owner and administrators create, list and cancel invites. The person it's for (signed in with that
// email address) can read it, and uses it up when joining, which needs a confirmed email address.
//
// Subcollection: groups/{groupId}/sessions/{sessionId}
// Document ID: auto-generated
// One for each time a story set was played to the patient.
// Fields (all required at create, no others):
//   - playedBy: string - the uid of the member who played it
//   - affect: string, "happy" or "challenging", and setNumber: int (1 or 2) - the set played
//   - day: string ("YYYY-MM-DD") - the day it counts toward, on the player's calendar
//   - startedAt: timestamp - server time of the save, when the set started playing
//   - prepared: list of the checklist items ticked before playing: all of "soundCheck", "told",
//     "earbuds", "quiet" and "outOfView", plus "hearingAid" for a patient who uses one
//   - awake: list (possibly empty) of the signs of being awake the patient showed: "eyesOpen",
//     "eyesToArousal", "followsInstruction", "intentionalMovement", "turnsToSound", "makesSounds"
//     and "respondsToTouch"
// Field added later, once:
//   - endedAt: timestamp - server time when the set played to the end; absent if it was stopped
// Members can read a group's sessions, and those who can play save their own. The member who played
// one adds endedAt; nothing else changes, and nobody can delete one.
//
// Collection: treatments/{treatmentId}/stories
// Treatment ID: only "demo"; stories are split by group instead (the `group` field).
// The treatments/{treatmentId} document itself is never read or written.
// Document ID: auto-generated
// Fields (all required at create, no others):
//   - title: string (1-100 chars) - e.g. "Heather and Dave's wedding"
//   - storyteller: string (1-100 chars) - the family member telling the story
//   - relationship: nonempty string, up to 100 characters (including custom and older values)
//   - affect: string, "happy" or "challenging"
//   - setNumber: int (1 or 2) - which of the two sets with this affect; the only field that can
//     change after create (moving a story to the other set with the same affect)
//   - group: string - the ID of the group the story belongs to; the writer must be a member
//   - nameDuration: int (1-60,000) - ms of the clip saying the patient's name 3 times
//   - storyDuration: int (1-300,000) - ms of the story clip; with the name clip, at most 5:00
//     (nameDuration + storyDuration <= 300,000). A set holds any number of stories.
//   - type: string (1-100 chars, starts with "audio/") - format of both clips
//   - nameSize: int (1 to size - 1) - bytes of the name clip; the story clip's bytes follow it
//   - size: int (2-5,000,000) - total audio bytes of both clips
//   - chunkCount: int (1-5) - number of chunk documents, ceil(size / 1,000,000)
//   - createdAt: timestamp - server time of the save
// Fields added when a story is deleted (a soft delete: it can be restored for 30 days):
//   - deletedAt: timestamp - server time of the delete
//   - deletedBy: string - the uid of the member who deleted it
//   - replacedBy: string (optional) - set when an edit replaced it: the ID of the edited story,
//     created in the same batch
// After create, a story changes only by moving (setNumber), being deleted (adding the fields above)
// or being restored (removing them, and possibly changing setNumber). A deleted story can't move.
// It's removed for good, with its chunks, only once it has been deleted for 30 days.
// Stories saved before groups existed have no `group`, so nobody can read them until they're
// given one.
//
// Subcollection: treatments/{treatmentId}/stories/{storyId}/chunks
// Document ID: "0" to "4" (chunk index)
// Fields (required, no others, immutable):
//   - data: bytes (1-1,000,000) - one piece of the audio
//
// The app saves a story and all its chunks in one batch, and removes them for good in one batch.
// It lists a group's stories with where('group', '==', groupId), reads chunks by ID, moves a
// story by updating only its setNumber, and deletes or restores one by updating it.
// It lists a day's sessions with where('day', '==', day), saves one with a single add, and adds
// endedAt with a single update.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // The signed-in person's email address, lowercase, or '' for an account without one.
    function myEmail() {
      return isSignedIn() && 'email' in request.auth.token && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function isStringOfLength(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function isIntInRange(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isValidEmail(value) {
      return isStringOfLength(value, 3, 254) && value == value.lower()
        && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidGroupId(groupId) {
      return groupId is string && groupId.size() >= 1 && groupId.size() <= 1500
        && groupId.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function invitePath(groupId, inviteId) {
      return /databases/$(database)/documents/groups/$(groupId)/invites/$(inviteId);
    }

    function isMember(groupId) {
      return isSignedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    // The lead caregiver: the person who started the group.
    function isOwner(groupId) {
      return isSignedIn() && get(groupPath(groupId)).data.ownerId == request.auth.uid;
    }

    // Must match ACCESS in src/access.js.
    function isAccessLevel(value) {
      return value in ['administrator', 'clinician', 'stories', 'player'];
    }

    // The signed-in member's access level; members from before access levels have "stories".
    function accessIn(groupId) {
      return get(memberPath(groupId, request.auth.uid)).data.get('access', 'stories');
    }

    // Invite and remove people, and change their access: the owner and administrators.
    function canManage(groupId) {
      return isMember(groupId) && (isOwner(groupId) || accessIn(groupId) == 'administrator');
    }

    // Record, edit, move, delete and restore stories: everyone but players.
    function canRecord(groupId) {
      return isMember(groupId) && (isOwner(groupId) || accessIn(groupId) in ['administrator', 'clinician', 'stories']);
    }

    // Play story sets to the patient: everyone but those who only record.
    function canPlay(groupId) {
      return isMember(groupId) && (isOwner(groupId) || accessIn(groupId) in ['administrator', 'clinician', 'player']);
    }

    // How long a deleted story can be restored before it may be removed for good.
    // Must match RECOVERY_DAYS in src/stories.js.
    function recoveryPeriod() {
      return duration.value(30, 'd');
    }

    // The only treatment: stories are split into groups by their `group` field instead.
    function isDemoTreatment(treatmentId) {
      return treatmentId == 'demo';
    }

    function storyPath(treatmentId, storyId) {
      return /databases/$(database)/documents/treatments/$(treatmentId)/stories/$(storyId);
    }

    function storyChunkPath(treatmentId, storyId, index) {
      return /databases/$(database)/documents/treatments/$(treatmentId)/stories/$(storyId)/chunks/$(string(index));
    }

    // True if chunk `index` will exist after this batch (or isn't needed for this many chunks).
    function storyChunkWrittenIfNeeded(treatmentId, storyId, chunkCount, index) {
      return index >= chunkCount || existsAfter(storyChunkPath(treatmentId, storyId, index));
    }

    // True if chunk `index` will be gone after this batch (or never existed for this many chunks).
    function storyChunkDeletedIfPresent(treatmentId, storyId, chunkCount, index) {
      return index >= chunkCount || !existsAfter(storyChunkPath(treatmentId, storyId, index));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidGroup(groupId, data) {
      let fields = ['id', 'name', 'ownerId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isValidGroupId(groupId)
        && data.id == groupId
        && isStringOfLength(data.name, 1, 100)
        && data.ownerId == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // A member document for the signed-in person, with their own email address.
    function isValidMember(memberId, data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'joinedAt', 'access', 'invite'])
        && (!('access' in data) || isAccessLevel(data.access))
        && memberId == request.auth.uid
        && data.uid == memberId
        && isStringOfLength(data.name, 1, 100)
        && myEmail() != '' && data.email == myEmail()
        && data.joinedAt == request.time;
    }

    // Starting a group: the owner's own member document, as an administrator, written in the same
    // batch as the new group.
    function isStartingGroup(groupId, data) {
      return !('invite' in data)
        && data.get('access', 'administrator') == 'administrator'
        && !exists(groupPath(groupId))
        && getAfter(groupPath(groupId)).data.ownerId == request.auth.uid;
    }

    // Accepting an invite: it's for this person's confirmed email address, they join with its access
    // level, and it's used up (deleted) in the same batch, so it can't be used twice.
    function isAcceptingInvite(groupId, data) {
      return 'invite' in data
        && data.invite is string
        && isEmailVerified()
        && exists(invitePath(groupId, data.invite))
        && get(invitePath(groupId, data.invite)).data.email == myEmail()
        && data.get('access', 'stories') == get(invitePath(groupId, data.invite)).data.get('access', 'stories')
        && !existsAfter(invitePath(groupId, data.invite));
    }

    // Changing someone's access level: only that field, to a real level, and never one's own or the
    // owner's.
    function isChangingAccess(groupId, memberId) {
      return memberId != request.auth.uid
        && memberId != get(groupPath(groupId)).data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['access'])
        && isAccessLevel(request.resource.data.access);
    }

    // Answering whether the patient uses a hearing aid: added once, and nothing else changes.
    function isSettingHearingAid() {
      return !('hearingAid' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearingAid'])
        && request.resource.data.hearingAid is bool;
    }

    function isValidInvite(groupId, data) {
      let fields = ['email', 'groupName', 'invitedBy', 'invitedByName', 'createdAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields.concat(['access']))
        && isValidEmail(data.email)
        && (!('access' in data) || isAccessLevel(data.access))
        && data.groupName == get(groupPath(groupId)).data.name
        && data.invitedBy == request.auth.uid
        && isStringOfLength(data.invitedByName, 1, 100)
        && data.createdAt == request.time;
    }

    function isValidStory(treatmentId, storyId, data) {
      let fields = ['title', 'storyteller', 'relationship', 'affect', 'setNumber', 'group',
                    'nameDuration', 'storyDuration', 'type', 'nameSize', 'size', 'chunkCount', 'createdAt'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && isStringOfLength(data.title, 1, 100)
        && isStringOfLength(data.storyteller, 1, 100)
        && isStringOfLength(data.relationship, 1, 100)
        && data.relationship.matches('.*[^\\s].*')
        && data.affect in ['happy', 'challenging']
        && isIntInRange(data.setNumber, 1, 2)
        && isValidGroupId(data.group)
        && isIntInRange(data.nameDuration, 1, 60000)
        && isIntInRange(data.storyDuration, 1, 300000)
        && data.nameDuration + data.storyDuration <= 300000 // a story is at most 5:00, counting the name
        && isStringOfLength(data.type, 1, 100) && data.type.matches('^audio/.*')
        && isIntInRange(data.size, 2, 5000000)
        && isIntInRange(data.nameSize, 1, data.size - 1) // both clips have audio
        && data.chunkCount is int && data.chunkCount == math.ceil(data.size / 1000000.0) // .0: whole-number division would round down
        && data.createdAt == request.time
        // Every chunk must be saved in the same batch, so no story exists without its audio.
        && storyChunkWrittenIfNeeded(treatmentId, storyId, data.chunkCount, 0)
        && storyChunkWrittenIfNeeded(treatmentId, storyId, data.chunkCount, 1)
        && storyChunkWrittenIfNeeded(treatmentId, storyId, data.chunkCount, 2)
        && storyChunkWrittenIfNeeded(treatmentId, storyId, data.chunkCount, 3)
        && storyChunkWrittenIfNeeded(treatmentId, storyId, data.chunkCount, 4);
    }

    // Moving a story: only setNumber changes, to 1 or 2. The affect and group can't change, so a story
    // only moves between the two sets with the same affect, and every other field stays as validated on create.
    // A deleted story can't move.
    function isValidStoryMove() {
      return !('deletedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['setNumber'])
        && isIntInRange(request.resource.data.setNumber, 1, 2);
    }

    // A story created in this same batch, in the same group: the edited version of a story.
    function isNewStoryInBatch(treatmentId, storyId, groupId) {
      return isStringOfLength(storyId, 1, 100) && storyId.matches('^[A-Za-z0-9]+$')
        && !exists(storyPath(treatmentId, storyId))
        && existsAfter(storyPath(treatmentId, storyId))
        && getAfter(storyPath(treatmentId, storyId)).data.group == groupId;
    }

    // Deleting a story: it's only marked, by the signed-in member, now. If an edit replaced it,
    // replacedBy names the edited story, saved in the same batch.
    function isValidSoftDelete(treatmentId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return !('deletedAt' in resource.data)
        && changed.hasAll(['deletedAt', 'deletedBy'])
        && changed.hasOnly(['deletedAt', 'deletedBy', 'replacedBy'])
        && data.deletedAt == request.time
        && data.deletedBy == request.auth.uid
        && (!('replacedBy' in data) || isNewStoryInBatch(treatmentId, data.replacedBy, resource.data.group));
    }

    // Restoring a deleted story: the delete fields go, and it may go back to either set of its affect.
    function isValidRestore() {
      let data = request.resource.data;
      return 'deletedAt' in resource.data
        && !('deletedAt' in data) && !('deletedBy' in data) && !('replacedBy' in data)
        && data.diff(resource.data).affectedKeys().hasOnly(['deletedAt', 'deletedBy', 'replacedBy', 'setNumber'])
        && isIntInRange(data.setNumber, 1, 2);
    }

    // A story can be removed for good only after it has been deleted for the whole recovery period.
    function isPastRecovery() {
      return 'deletedAt' in resource.data && resource.data.deletedAt < request.time - recoveryPeriod();
    }

    // A session, saved by the member who played it, as the set starts. The checklist items and
    // signs of being awake must match PREPARE and AWAKE in src/playing.js.
    function isValidSession(data) {
      let fields = ['playedBy', 'affect', 'setNumber', 'day', 'startedAt', 'prepared', 'awake'];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
        && data.playedBy == request.auth.uid
        && data.affect in ['happy', 'challenging']
        && isIntInRange(data.setNumber, 1, 2)
        && data.day is string && data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startedAt == request.time
        && data.prepared is list && data.prepared.size() <= 6
        && data.prepared.hasAll(['soundCheck', 'told', 'earbuds', 'quiet', 'outOfView'])
        && data.prepared.hasOnly(['hearingAid', 'soundCheck', 'told', 'earbuds', 'quiet', 'outOfView'])
        && data.awake is list && data.awake.size() <= 7
        && data.awake.hasOnly(['eyesOpen', 'eyesToArousal', 'followsInstruction', 'intentionalMovement',
                               'turnsToSound', 'makesSounds', 'respondsToTouch']);
    }

    // The set played to the end: its player adds endedAt, now, once, and nothing else changes.
    function isEndingSession() {
      return resource.data.playedBy == request.auth.uid
        && !('endedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt'])
        && request.resource.data.endedAt == request.time;
    }

    function isValidStoryChunk(treatmentId, storyId, chunkId, data) {
      return data.keys().hasAll(['data']) && data.keys().hasOnly(['data'])
        && data.data is bytes && data.data.size() >= 1 && data.data.size() <= 1000000
        && chunkId.matches('^[0-4]$')
        // Chunks can only be written together with a brand-new story, never added later.
        && !exists(storyPath(treatmentId, storyId))
        && existsAfter(storyPath(treatmentId, storyId))
        && int(chunkId) < getAfter(storyPath(treatmentId, storyId)).data.chunkCount;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /groups/{groupId} {
      allow read: if isMember(groupId);
      // Started together with the owner's member document.
      allow create: if isSignedIn()
        && isValidGroup(groupId, request.resource.data)
        && existsAfter(memberPath(groupId, request.auth.uid));
      allow update: if canPlay(groupId) && isSettingHearingAid();
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(groupId);
        allow create: if isSignedIn()
          && isValidMember(memberId, request.resource.data)
          && (isStartingGroup(groupId, request.resource.data) || isAcceptingInvite(groupId, request.resource.data));
        allow update: if canManage(groupId) && isChangingAccess(groupId, memberId);
        // The owner or an administrator removes someone else, or a member leaves. The owner can't
        // leave or be removed.
        allow delete: if isSignedIn()
          && memberId != get(groupPath(groupId)).data.ownerId
          && (canManage(groupId) || memberId == request.auth.uid);
      }

      match /invites/{inviteId} {
        allow read: if canManage(groupId) || (myEmail() != '' && resource.data.email == myEmail());
        allow create: if canManage(groupId) && isValidInvite(groupId, request.resource.data);
        allow update: if false;
        // The owner or an administrator cancels it, or the person it's for uses it up when joining.
        allow delete: if canManage(groupId)
          || (isEmailVerified() && myEmail() != '' && resource.data.email == myEmail());
      }

      match /sessions/{sessionId} {
        allow read: if isMember(groupId);
        allow create: if canPlay(groupId) && isValidSession(request.resource.data);
        allow update: if isMember(groupId) && isEndingSession();
        allow delete: if false;
      }
    }

    // Everyone can find their own memberships: query(collectionGroup('members'), where('uid', '==', uid)).
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /treatments/{treatmentId}/stories/{storyId} {
      allow read: if isDemoTreatment(treatmentId) && isMember(resource.data.group);
      allow create: if isDemoTreatment(treatmentId)
        && isValidStory(treatmentId, storyId, request.resource.data)
        && canRecord(request.resource.data.group);
      allow update: if isDemoTreatment(treatmentId) && canRecord(resource.data.group)
        && (isValidStoryMove() || isValidSoftDelete(treatmentId) || isValidRestore());
      // Removed for good only after the recovery period, and only together with all of its chunks.
      // Any member can, since the app does it whenever someone loads the stories (see storage.js).
      allow delete: if isDemoTreatment(treatmentId)
        && isMember(resource.data.group)
        && isPastRecovery()
        && storyChunkDeletedIfPresent(treatmentId, storyId, resource.data.chunkCount, 0)
        && storyChunkDeletedIfPresent(treatmentId, storyId, resource.data.chunkCount, 1)
        && storyChunkDeletedIfPresent(treatmentId, storyId, resource.data.chunkCount, 2)
        && storyChunkDeletedIfPresent(treatmentId, storyId, resource.data.chunkCount, 3)
        && storyChunkDeletedIfPresent(treatmentId, storyId, resource.data.chunkCount, 4);

      match /chunks/{chunkId} {
        allow read: if isDemoTreatment(treatmentId) && isMember(get(storyPath(treatmentId, storyId)).data.group);
        allow create: if isDemoTreatment(treatmentId)
          && isValidStoryChunk(treatmentId, storyId, chunkId, request.resource.data)
          && canRecord(getAfter(storyPath(treatmentId, storyId)).data.group);
        allow update: if false;
        // Removed only together with the story it belongs to (which needs the recovery period to be over).
        allow delete: if isDemoTreatment(treatmentId)
          && isMember(get(storyPath(treatmentId, storyId)).data.group)
          && !existsAfter(storyPath(treatmentId, storyId));
      }
    }

    // Everything else, including treatments/{treatmentId} itself, is denied by default.
  }
}
